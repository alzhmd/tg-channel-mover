# Bot token from @BotFather
BOT_TOKEN=123456:ABC...
# Comma-separated numeric Telegram user ids allowed to control the bot
ADMIN_IDS=
# Optional: anyone who sends "/start <CLAIM_CODE>" becomes an admin too (leave empty to disable)
CLAIM_CODE=
DB_PATH=data/chanmover.db
# Messages per copyMessages call (max 100). The engine shrinks it by itself after a flood-wait.
BATCH_SIZE=20
# Seconds to pause between two calls
BATCH_DELAY=1.0
# Private sources: stop after this many empty ids past the newest post found
LOOKAHEAD=600
# Seconds between two t.me/s pages when listing a public channel
SCRAPE_DELAY=0.35
