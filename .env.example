# Bot token from @BotFather
BOT_TOKEN=123456:ABC...
# Comma-separated numeric Telegram user ids allowed to control the bot
ADMIN_IDS=
# Optional: anyone who sends "/start <CLAIM_CODE>" becomes an admin too (leave empty to disable)
CLAIM_CODE=
DB_PATH=data/chanmover.db
# --- Premium-account engine (optional) ---
# App credentials from https://my.telegram.org -> API development tools. Without them the engine is off.
TG_API_ID=
TG_API_HASH=
# Where the connected account's session is kept (connect it from the bot: main menu -> Premium account)
USER_SESSION=data/user
# Ordinary -> Premium emoji map (JSON); empty = the bundled one
PREMIUM_EMOJI_FILE=
# Posts per window with the Premium-account engine
USER_BATCH_SIZE=20
# Seconds the account waits per post it writes (a safe, steady pace; it slows down further after any flood wait)
USER_MIN_INTERVAL=0.8

# Messages per copyMessages call (max 100). The engine shrinks it by itself after a flood-wait.
BATCH_SIZE=20
# Seconds to pause between two calls
BATCH_DELAY=1.0
# Private sources: stop after this many empty ids past the newest post found
LOOKAHEAD=600
# Seconds between two t.me/s pages when listing a public channel
SCRAPE_DELAY=0.35
